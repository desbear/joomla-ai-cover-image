<?xml version="1.0" encoding="UTF-8"?>
<extension type="plugin" group="system" method="upgrade">
	<name>plg_system_gssaiimageflexi</name>
	<author>GSS</author>
	<creationDate>2026-10-17</creationDate>
	<copyright>(C) 2026 GSS</copyright>
	<license>GNU General Public License version 2 or later; see LICENSE</license>
	<version>2.0.0</version>
	<description>PLG_SYSTEM_GSSAIIMAGEFLEXI_XML_DESCRIPTION</description>
	<namespace path="src">Gss\Plugin\System\GssAiImageFlexi</namespace>

	<files>
		<folder plugin="gssaiimageflexi">services</folder>
		<folder>src</folder>
		<folder>language</folder>
		<filename>LICENSE</filename>
	</files>

	<media destination="plg_system_gssaiimageflexi" folder="media">
		<folder>js</folder>
	</media>

	<config>
		<fields name="params">
			<fieldset name="basic" description="PLG_SYSTEM_GSSAIIMAGEFLEXI_FIELDSET_DESC">
				<field name="flexi_admin" type="radio" default="1" layout="joomla.form.field.radio.switcher"
					label="PLG_SYSTEM_GSSAIIMAGEFLEXI_ADMIN_LABEL"
					description="PLG_SYSTEM_GSSAIIMAGEFLEXI_ADMIN_DESC">
					<option value="0">JNO</option>
					<option value="1">JYES</option>
				</field>
				<field name="flexi_site" type="radio" default="1" layout="joomla.form.field.radio.switcher"
					label="PLG_SYSTEM_GSSAIIMAGEFLEXI_SITE_LABEL"
					description="PLG_SYSTEM_GSSAIIMAGEFLEXI_SITE_DESC">
					<option value="0">JNO</option>
					<option value="1">JYES</option>
				</field>
				<field name="extra_fields" type="text" default="" filter="string"
					label="PLG_SYSTEM_GSSAIIMAGEFLEXI_EXTRA_FIELDS_LABEL"
					description="PLG_SYSTEM_GSSAIIMAGEFLEXI_EXTRA_FIELDS_DESC" />
				<field name="content_ids" type="text" default="jform_text" filter="string"
					label="PLG_SYSTEM_GSSAIIMAGEFLEXI_CONTENT_IDS_LABEL"
					description="PLG_SYSTEM_GSSAIIMAGEFLEXI_CONTENT_IDS_DESC" />
				<field name="output_format" type="list" default="jpg"
					label="PLG_SYSTEM_GSSAIIMAGEFLEXI_FORMAT_LABEL"
					description="PLG_SYSTEM_GSSAIIMAGEFLEXI_FORMAT_DESC">
					<option value="jpg">JPEG</option>
					<option value="png">PNG</option>
					<option value="webp">WebP</option>
					<option value="core">PLG_SYSTEM_GSSAIIMAGEFLEXI_FORMAT_CORE</option>
				</field>
			</fieldset>
		</fields>
	</config>
</extension>
